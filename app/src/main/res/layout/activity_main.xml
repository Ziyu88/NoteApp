<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".MainActivity">

    <!-- 顶部工具栏（滑动后显示标题，平时只显示图标） -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@color/background_primary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- 退出多选按钮（多选模式时显示） -->
        <ImageButton
            android:id="@+id/buttonExitMultiSelect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/icon_tint"
            android:visibility="gone" />

        <!-- 已选择数量文本（多选模式时显示） -->
        <TextView
            android:id="@+id/textSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="已选择 0 项"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <!-- 多选图标（多选模式时显示） -->
        <ImageButton
            android:id="@+id/buttonMultiSelectIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@color/icon_tint"
            android:visibility="gone" />

        <!-- 滑动后显示的小标题（普通模式，初始隐藏） -->
        <TextView
            android:id="@+id/textAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="笔记"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <!-- 文件夹图标 📁 -->
        <ImageButton
            android:id="@+id/buttonCategory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@+id/buttonSettings"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_folder"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <!-- 设置图标 ⚙️ -->
        <ImageButton
            android:id="@+id/buttonSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="12dp" />

    </RelativeLayout>

    <!-- 大标题区域（平时显示，滑动时隐藏） -->
    <TextView
        android:id="@+id/textLargeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="笔记"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- 搜索框（平时显示，滑动时隐藏） -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textLargeTitle"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:background="@color/background_search">

        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="搜索笔记"
            android:paddingStart="40dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_search_box"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/icon_tint" />

        <ImageButton
            android:id="@+id/buttonClearSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/icon_tint"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 分类横向标签（始终显示） -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/searchContainer"
        android:background="@color/background_primary"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/categoryChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- RecyclerView 用于显示笔记（卡片式布局） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewNotes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/categoryScroll"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:clipChildren="false" />

    <!-- 添加笔记按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:contentDescription="添加笔记"
        android:src="@android:drawable/ic_input_add"
        android:tint="@android:color/white"
        android:backgroundTint="@color/purple_500" />

    <!-- 删除按钮（多选模式时显示） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:contentDescription="删除笔记"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="@android:color/white"
        android:backgroundTint="#F44336"
        android:visibility="gone" />

    <!-- 底部操作栏（多选模式时显示） -->
    <include layout="@layout/bottom_action_bar" />

</RelativeLayout>

